#!/usr/bin/env python3
"""Write one self-contained installer for session naming on a machine without the platform.

    ai-title-bundle > naming-install.py
    python3 naming-install.py install      # on the other machine (macOS or Linux, python3 only)
    python3 naming-install.py status

    ai-title-bundle --client > client-install.py

With --client the installer also carries the other portable rules, so local agents on a client
machine (the laptop) follow the same rules as dev-server: the STE writing standard
(skills/develop/ste100.md, in its ste100 markers), the commit rule, the rule that engineering on a
platform repository runs on dev-server over SSH, the Claude Code PreToolUse guard
(hooks/pre-tool-use-guard.sh) and the global git hooks (hooks/git, through core.hooksPath). It
leaves out what needs dev-server: dev-loop, the /opt release, the platform skills and the accounts.
It does not change Codex sandbox or approval settings, or any credential.

The installer carries the title formatter, the Claude Code hook and the Codex hook. It puts
them in ~/.local/share/dev-platform-naming, adds the hooks to every Claude Code home
(~/.claude and ~/.claude-accounts/*, which the CLI, the desktop app and the IDE extensions
read) and to Codex, and adds the naming rule and the owner's words (skills/develop/owner-words.md)
to each global prompt file. It keeps every
other setting and writes a backup of each file it changes. See docs/session-naming.md.
"""
import base64
import json
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / 'lib'))
from ai_ecosystem.guardrails import COMMIT_RULE, NAMING_RULE, owner_words  # noqa: E402

CLIENT_FILES = ('hooks/pre-tool-use-guard.sh', 'hooks/guard_git.py', 'lib/ai_ecosystem/tiers.py',
                'hooks/git/commit-msg', 'hooks/git/pre-push')
STE_FILE = 'skills/develop/ste100.md'
REMOTE_RULE = ('Engineering work on a platform repository runs on dev-server over SSH. On this machine, '
               'do not clone, build or commit a platform repository; open it on dev-server (`ssh dev-server`, '
               'or a Zed remote project) and work there.')

FILES = ('lib/ai_ecosystem/__init__.py', 'lib/ai_ecosystem/naming.py', 'lib/ai_ecosystem/codex_control.py',
         'hooks/session-title.py', 'hooks/codex-session-title.py', 'bin/ai-title',
         'integrations/pi/session-title.mjs')

INSTALLER = r'''#!/usr/bin/env python3
"""Session naming for this machine. Generated by dev-platform bin/ai-title-bundle; do not edit."""
import base64, datetime, json, os, shutil, subprocess, sys
from pathlib import Path

FILES = __FILES__
RULE = __RULE__
NAMING = __NAMING__
CLIENT = __CLIENT__
STE = __STE__
TITLE_BEGIN = '<!-- dev-platform session title: begin (managed by naming-install.py) -->'
TITLE_END = '<!-- dev-platform session title: end -->'
CLIENT_BEGIN = '<!-- dev-platform client rules: begin (managed by client-install.py) -->'
CLIENT_END = '<!-- dev-platform client rules: end -->'
BEGIN, END = (CLIENT_BEGIN, CLIENT_END) if CLIENT else (TITLE_BEGIN, TITLE_END)
OTHER = (TITLE_BEGIN, TITLE_END) if CLIENT else (CLIENT_BEGIN, CLIENT_END)
STE_BEGIN = '<!-- ste100: begin'
STE_END = '<!-- ste100: end -->'
GUARD = 'pre-tool-use-guard.sh'
MARK = 'dev-platform-naming/hooks/'
HOME = Path.home()
PREFIX = HOME / '.local/share/dev-platform-naming'
STAMP = datetime.datetime.now().strftime('%Y%m%dT%H%M%S')
BACKUP = HOME / '.local/state/dev-platform-naming/backup' / STAMP


def backup(path):
    if path.exists():
        dest = BACKUP / path.relative_to(HOME)
        dest.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(path, dest)


def write(path, text):
    if path.exists() and path.read_text() == text:
        return
    backup(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + '.new')
    tmp.write_text(text)
    os.replace(tmp, path)


def claude_homes():
    homes = [HOME / '.claude']
    homes += sorted(p for p in (HOME / '.claude-accounts').glob('*') if p.is_dir())
    extra = os.environ.get('CLAUDE_CONFIG_DIR')
    if extra and Path(extra).expanduser() not in homes:
        homes.append(Path(extra).expanduser())
    return homes


def hook_command(name):
    if name.endswith('.sh'):
        return f"'{PREFIX / 'hooks' / name}'"
    return f"python3 '{PREFIX / 'hooks' / name}'"


def add_hooks(path, events, name, matcher=None):
    try:
        data = json.loads(path.read_text()) if path.exists() else {}
    except ValueError:
        return f'{path}: not valid JSON; left alone'
    hooks = data.setdefault('hooks', {})
    for event in events:
        groups = hooks.setdefault(event, [])
        for group in groups:  # one copy per event: drop ours and any older copy of the same hook
            group['hooks'] = [h for h in group.get('hooks', []) if MARK + name not in h.get('command', '')
                              and not h.get('command', '').rstrip("' ").endswith(f'/hooks/{name}')
                              and f'/hooks/{name}"' not in h.get('command', '')]
        groups[:] = [g for g in groups if g.get('hooks')]
        group = {'hooks': [{'type': 'command', 'command': hook_command(name), 'timeout': 10}]}
        if event == 'PostToolUse' and name == 'session-title.py':
            group = {'matcher': 'mcp__ccd_session_mgmt__set_session_title', **group}   # only the rename tool
        elif matcher:
            group = {'matcher': matcher, **group}
        groups.append(group)
    write(path, json.dumps(data, indent=2) + '\n')


def drop_block(text, begin, end):
    if begin in text and end in text:
        head, rest = text.split(begin, 1)
        return head.rstrip('\n') + '\n' + rest.split(end, 1)[1].lstrip('\n')
    return text


def add_rule(path):
    old = path.read_text() if path.exists() else ''
    if 'dev-platform guardrails: begin' in old:  # the platform's own block carries the rule; keep one copy
        write(path, drop_block(drop_block(old, BEGIN, END), *OTHER))
        return
    old = drop_block(old, *OTHER)  # the client block and the title block carry the same rule: keep one
    text = f'{BEGIN}\n{RULE}\n{END}'
    if BEGIN in old and END in old:
        head, rest = old.split(BEGIN, 1)
        new = head + text + rest.split(END, 1)[1]
    else:
        new = (old.rstrip('\n') + '\n\n' if old.strip() else '') + text + '\n'
    write(path, new)


def ste_body():
    return STE.split('\n', 1)[1].rsplit('\n' + STE_END, 1)[0].strip('\n')


def add_ste(path):
    """Put the STE block, in its markers, in the file. Text with no markers is wrapped only when it is the same."""
    old = path.read_text() if path.exists() else ''
    if STE_BEGIN in old and STE_END in old:
        head, rest = old.split(STE_BEGIN, 1)
        write(path, head + STE + rest.split(STE_END, 1)[1])
        return None
    body = ste_body()
    if body in old:
        write(path, old.replace(body, STE, 1))
        return None
    if '# Writing standard: ASD-STE100' in old:
        return f'{path}: STE text with no ste100 markers that is not the same as the bundle; left alone, remove it by hand and install again'
    write(path, (old.rstrip('\n') + '\n\n' if old.strip() else '') + STE + '\n')
    return None


def git_hooks_path():
    done = subprocess.run(['git', 'config', '--global', '--get', 'core.hooksPath'], capture_output=True, text=True)
    return done.stdout.strip() or None


def set_git_hooks():
    target = str(PREFIX / 'hooks/git')
    current = git_hooks_path()
    if current and current != target and 'dev-platform' not in current:
        return f'core.hooksPath is {current}; left alone (the platform hooks are {target})'
    if current != target:
        subprocess.run(['git', 'config', '--global', 'core.hooksPath', target], check=True)
    return None


def prompt_files():
    files = [home / 'CLAUDE.md' for home in claude_homes()]
    if (HOME / '.codex').is_dir():
        files.append(HOME / '.codex/AGENTS.md')
    if (HOME / '.copilot').is_dir():
        files.append(HOME / '.copilot/copilot-instructions.md')
    if (HOME / '.pi/agent').is_dir():
        files.append(HOME / '.pi/agent/APPEND_SYSTEM.md')
    return files


def has_guard(settings):
    try:
        groups = json.loads(settings.read_text()).get('hooks', {}).get('PreToolUse', [])
    except (OSError, ValueError):
        return False
    return any(g.get('matcher') == 'Bash' and MARK + GUARD in h.get('command', '')
               for g in groups for h in g.get('hooks', []))


def trust_codex():
    sys.path.insert(0, str(PREFIX / 'lib'))
    try:
        from ai_ecosystem import codex_control
        if not codex_control.socket_path().exists():
            return ('Codex: no app-server socket; approve the title hook once in the Codex hook review '
                    '(it runs only when trusted) and keep the Codex app or daemon running')
        codex_control.trust_hooks(MARK)
    except Exception as error:  # the install itself is done; trust is a separate step
        return f'Codex: could not trust the title hook ({error}); approve it in the Codex hook review'
    return None


def install():
    for rel, data in FILES.items():
        dest = PREFIX / rel
        write(dest, base64.b64decode(data).decode())
        if rel.startswith(('hooks/', 'bin/')):
            dest.chmod(0o755)
    notes = []
    if CLIENT:
        for home in claude_homes():
            notes.append(add_hooks(home / 'settings.json', ('PreToolUse',), GUARD, matcher='Bash'))
        notes += [add_ste(path) for path in prompt_files()]
        notes.append(set_git_hooks())
    for home in claude_homes():
        notes.append(add_hooks(home / 'settings.json', ('SessionStart', 'UserPromptSubmit', 'Stop', 'PostToolUse'), 'session-title.py'))
        add_rule(home / 'CLAUDE.md')
    if (HOME / '.codex').is_dir():
        notes.append(add_hooks(HOME / '.codex/hooks.json', ('SessionStart', 'UserPromptSubmit', 'PostToolUse', 'Stop'),
                               'codex-session-title.py'))
        add_rule(HOME / '.codex/AGENTS.md')
        notes.append(trust_codex())
    if (HOME / '.copilot').is_dir():
        add_rule(HOME / '.copilot/copilot-instructions.md')
    if (HOME / '.pi/agent').is_dir():
        add_rule(HOME / '.pi/agent/APPEND_SYSTEM.md')
        write(HOME / '.pi/agent/extensions/session-title.ts', (PREFIX / 'integrations/pi/session-title.mjs').read_text())
    for note in filter(None, notes):
        print(note, file=sys.stderr)
    print(f'installed in {PREFIX}; backups in {BACKUP if BACKUP.exists() else "(none needed)"}')
    return status()


def status():
    problems = []
    for rel in FILES:
        if not (PREFIX / rel).is_file():
            problems.append(f'{PREFIX / rel}: missing')
    for home in claude_homes():
        settings = home / 'settings.json'
        text = settings.read_text() if settings.exists() else ''
        for event in ('SessionStart', 'UserPromptSubmit', 'Stop', 'PostToolUse'):
            try:
                groups = json.loads(text or '{}').get('hooks', {}).get(event, [])
            except ValueError:
                groups = []
            if not any(MARK in h.get('command', '') for g in groups for h in g.get('hooks', [])):
                problems.append(f'{settings}: no {event} title hook')
        prompt = home / 'CLAUDE.md'
        text = prompt.read_text() if prompt.exists() else ''
        # On a platform machine the guardrails block carries the naming rule and imports the
        # owner's words; add_rule() leaves that block alone, so it counts here too.
        if not (RULE in text or ('dev-platform guardrails: begin' in text and NAMING in text)):
            problems.append(f'{prompt}: no naming rule')
        if CLIENT and not has_guard(settings):
            problems.append(f'{settings}: no PreToolUse guard hook')
    if CLIENT:
        for path in prompt_files():
            if not (path.exists() and STE in path.read_text()):
                problems.append(f'{path}: no STE block in ste100 markers, or a different one')
        if git_hooks_path() != str(PREFIX / 'hooks/git'):
            problems.append(f'git core.hooksPath is {git_hooks_path()}, not {PREFIX / "hooks/git"}')
    for line in problems:
        print(line)
    if not problems:
        sample = os.popen(f"python3 '{PREFIX / 'bin/ai-title'}' format 'chore(naming): Check install' --client claude-desktop").read().strip()
        print(f'ok; a new session would be titled like: {sample}')
    return 1 if problems else 0


if __name__ == '__main__':
    command = sys.argv[1] if len(sys.argv) > 1 else 'install'
    sys.exit({'install': install, 'status': status}.get(command, lambda: print('usage: install|status') or 2)())
'''


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    if argv not in ([], ['--client']):
        print('usage: ai-title-bundle [--client]', file=sys.stderr)
        return 2
    client = argv == ['--client']
    names = FILES + (CLIENT_FILES if client else ())
    files = {rel: base64.b64encode((ROOT / rel).read_bytes()).decode() for rel in names}
    # The prompt files get the naming rule and the owner's words (one source: skills/develop/owner-words.md).
    parts = (COMMIT_RULE, REMOTE_RULE, NAMING_RULE) if client else (NAMING_RULE,)
    rule = '\n\n'.join(filter(None, parts + (owner_words(ROOT),)))
    ste = (ROOT / STE_FILE).read_text().strip('\n') if client else ''
    text = (INSTALLER.replace('__FILES__', json.dumps(files, indent=1)).replace('__RULE__', json.dumps(rule))
            .replace('__NAMING__', json.dumps(NAMING_RULE))
            .replace('__CLIENT__', repr(client)).replace('__STE__', json.dumps(ste)))
    sys.stdout.write(text)
    return 0


if __name__ == '__main__':
    sys.exit(main())
