#!/usr/bin/env python3
"""Forward unchanged arguments to the isolated, pinned native OpenRig runtime."""
import os
from pathlib import Path
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'lib'))
from ai_ecosystem import paths, rigapproval  # noqa: E402

runtime = Path(os.environ.get('DEV_WORKSPACE_RUNTIME') or paths.openrig_runtime())
node_bin = runtime / f'node-v24.14.0-{paths.node_platform()}/bin'
cli_bin = runtime / 'app/node_modules/.bin'
node = node_bin / 'node'
wrapper = cli_bin / 'rig'
if not node.is_file() or not wrapper.is_file():
    sys.exit('Pinned OpenRig runtime missing; see integrations/openrig/README.md.')
env = os.environ.copy()
env['PATH'] = paths.daemon_path(node_bin, cli_bin)  # a daemon started here gives its seats the seat programs
# A daemon started here never boots OpenRig's built-in kernel rig on its own: its seats would
# start paid sessions nobody asked for (they are refused anyway, see rigapproval).
env.setdefault('OPENRIG_NO_KERNEL', '1')
args = sys.argv[1:]
if rigapproval.needs_approval(args):
    rigapproval.approve(rigapproval.rig_name(args[1:]))   # without it the seats say so and stop
os.execve(str(node), [str(node), str(wrapper.resolve()), *args], env)
