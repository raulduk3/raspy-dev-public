{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dev-platform.local/schemas/task/v1.schema.json",
  "title": "dev-platform task item, version 1",
  "description": "One task in docs/tasks/<N>.json. Decision 0002, SDD area TK. Git records done (a commit on the base with the trailer `Task: #<N>`), so there is no done field.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "title", "kind", "goal", "state", "brief", "work", "acceptance", "created"],
  "properties": {
    "$schema": { "type": "string", "description": "Optional path to this schema, for editors." },
    "schema": { "const": "dev-platform/task@1" },
    "id": { "$ref": "#/$defs/task_id" },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 140,
      "pattern": "^[^\\n]+$",
      "description": "One line in the repository's form for task titles, usually the result that is true when the task is done."
    },
    "kind": { "enum": ["code", "spec", "research", "ops", "decision", "writing", "data"] },
    "goal": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*-[0-9]+$",
      "description": "The goal this task serves, for example G-2."
    },
    "state": { "enum": ["draft", "ready", "blocked", "cancelled"] },
    "blocked": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "needs"],
      "properties": {
        "reason": { "$ref": "#/$defs/line" },
        "needs": { "enum": ["owner", "task", "input", "access"] },
        "ask": { "$ref": "#/$defs/text" },
        "since": { "$ref": "#/$defs/date" }
      }
    },
    "cancelled": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": { "$ref": "#/$defs/line" },
        "superseded_by": { "$ref": "#/$defs/task_id" }
      }
    },
    "assignee": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["agent", "person"] },
        "name": { "$ref": "#/$defs/name" }
      }
    },
    "depends_on": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/task_id" }
    },
    "refs": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/ref" }
    },
    "facts": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": {
          "text": { "$ref": "#/$defs/text" },
          "as_of": { "type": "string", "minLength": 1, "maxLength": 60, "description": "A date or a commit." }
        }
      }
    },
    "brief": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000,
      "description": "The task in prose, in the repository's language for tasks: what is true now, the change and why. The worker reads it whole. The typed fields index the task; they do not replace this text."
    },
    "work": { "type": "object" },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/check" }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lane": { "$ref": "#/$defs/name" },
        "tier": { "$ref": "#/$defs/name" },
        "model": { "$ref": "#/$defs/name" }
      }
    },
    "labels": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$" }
    },
    "created": { "$ref": "#/$defs/date" },
    "ext": {
      "type": "object",
      "propertyNames": { "pattern": "^x-[a-z0-9][a-z0-9-]{0,39}$" },
      "description": "Fields a repository adds. Keys start with x-."
    }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "blocked" } }, "required": ["state"] },
      "then": { "required": ["blocked"] },
      "else": { "not": { "required": ["blocked"] } }
    },
    {
      "if": { "properties": { "state": { "const": "cancelled" } }, "required": ["state"] },
      "then": { "required": ["cancelled"] },
      "else": { "not": { "required": ["cancelled"] } }
    },
    { "if": { "properties": { "kind": { "const": "code" } } }, "then": { "properties": { "work": { "$ref": "#/$defs/work_code" } } } },
    { "if": { "properties": { "kind": { "const": "spec" } } }, "then": { "properties": { "work": { "$ref": "#/$defs/work_spec" } } } },
    { "if": { "properties": { "kind": { "const": "research" } } }, "then": { "properties": { "work": { "$ref": "#/$defs/work_research" } } } },
    { "if": { "properties": { "kind": { "const": "ops" } } }, "then": { "properties": { "work": { "$ref": "#/$defs/work_ops" } } } },
    { "if": { "properties": { "kind": { "const": "decision" } } }, "then": { "properties": { "work": { "$ref": "#/$defs/work_decision" } } } },
    { "if": { "properties": { "kind": { "const": "writing" } } }, "then": { "properties": { "work": { "$ref": "#/$defs/work_writing" } } } },
    { "if": { "properties": { "kind": { "const": "data" } } }, "then": { "properties": { "work": { "$ref": "#/$defs/work_data" } } } }
  ],
  "$defs": {
    "task_id": { "type": "integer", "minimum": 1 },
    "date": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" },
    "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._@/:-]{0,63}$" },
    "line": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\n]+$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 600 },
    "item": { "type": "string", "minLength": 1, "maxLength": 800 },
    "path": { "type": "string", "minLength": 1, "maxLength": 300, "pattern": "^[^/\\s][^\\s]*$" },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["spec", "decision", "task", "issue", "doc", "url", "owner"] },
        "id": { "$ref": "#/$defs/line" },
        "repo": { "$ref": "#/$defs/name" },
        "note": { "$ref": "#/$defs/line" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "decision" } }, "not": { "required": ["repo"] } },
          "then": { "properties": { "id": { "pattern": "^[0-9]{4}$" } } }
        },
        {
          "if": { "properties": { "type": { "const": "task" } }, "not": { "required": ["repo"] } },
          "then": { "properties": { "id": { "pattern": "^#[0-9]+$" } } }
        }
      ]
    },
    "check": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["by", "statement", "path"],
          "properties": {
            "by": { "const": "test" }, "statement": { "$ref": "#/$defs/text" },
            "path": { "$ref": "#/$defs/path" }, "name": { "$ref": "#/$defs/line" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["by", "statement", "run"],
          "properties": {
            "by": { "const": "command" }, "statement": { "$ref": "#/$defs/text" },
            "run": { "$ref": "#/$defs/line" }, "cwd": { "$ref": "#/$defs/path" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["by", "statement", "run", "metric", "op", "value"],
          "properties": {
            "by": { "const": "eval" }, "statement": { "$ref": "#/$defs/text" },
            "run": { "$ref": "#/$defs/line" }, "metric": { "$ref": "#/$defs/name" },
            "op": { "enum": [">=", "<=", "=="] }, "value": { "type": "number" },
            "unit": { "$ref": "#/$defs/name" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["by", "statement", "reviewer"],
          "properties": {
            "by": { "const": "review" }, "statement": { "$ref": "#/$defs/text" },
            "reviewer": { "$ref": "#/$defs/name" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["by", "statement", "path"],
          "properties": {
            "by": { "const": "artifact" }, "statement": { "$ref": "#/$defs/text" },
            "path": { "$ref": "#/$defs/path" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["by", "statement", "host"],
          "properties": {
            "by": { "const": "host" }, "statement": { "$ref": "#/$defs/text" },
            "host": { "$ref": "#/$defs/name" }, "run": { "$ref": "#/$defs/line" }
          }
        }
      ]
    },
    "changes": { "type": "array", "minItems": 1, "maxItems": 15, "items": { "$ref": "#/$defs/item" } },
    "work_code": {
      "type": "object", "additionalProperties": false,
      "required": ["scope"],
      "properties": {
        "scope": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
        "changes": { "$ref": "#/$defs/changes" },
        "step_zero": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/text" } }
      }
    },
    "work_spec": {
      "type": "object", "additionalProperties": false,
      "required": ["scope"],
      "properties": {
        "scope": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "allOf": [{ "$ref": "#/$defs/path" }, { "pattern": "^docs/" }] }
        },
        "changes": { "$ref": "#/$defs/changes" }
      }
    },
    "work_research": {
      "type": "object", "additionalProperties": false,
      "required": ["questions", "deliverable"],
      "properties": {
        "questions": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "$ref": "#/$defs/text" } },
        "sources": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/line" } },
        "deliverable": {
          "type": "object", "additionalProperties": false,
          "required": ["format", "path"],
          "properties": {
            "format": { "enum": ["html", "json", "tsv", "image"] },
            "path": { "$ref": "#/$defs/path" }
          }
        }
      }
    },
    "work_ops": {
      "type": "object", "additionalProperties": false,
      "required": ["host", "steps", "rollback"],
      "properties": {
        "host": { "$ref": "#/$defs/name" },
        "steps": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/item" } },
        "rollback": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/item" } },
        "window": { "$ref": "#/$defs/line" }
      }
    },
    "work_decision": {
      "type": "object", "additionalProperties": false,
      "required": ["question", "options", "record"],
      "properties": {
        "question": { "$ref": "#/$defs/text" },
        "options": {
          "type": "array", "minItems": 2, "maxItems": 6,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "text"],
            "properties": {
              "id": { "type": "string", "pattern": "^[A-F]$" },
              "text": { "$ref": "#/$defs/text" }
            }
          }
        },
        "recommended": { "type": "string", "pattern": "^[A-F]$" },
        "record": { "$ref": "#/$defs/path" }
      }
    },
    "work_writing": {
      "type": "object", "additionalProperties": false,
      "required": ["destination", "form"],
      "properties": {
        "destination": { "$ref": "#/$defs/line" },
        "form": { "enum": ["email", "commit", "page", "legal", "post", "doc", "prompt", "other"] },
        "audience": { "$ref": "#/$defs/line" },
        "path": { "$ref": "#/$defs/path" }
      }
    },
    "work_data": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "target", "transform"],
      "properties": {
        "source": { "$ref": "#/$defs/line" },
        "target": { "$ref": "#/$defs/line" },
        "transform": { "type": "array", "minItems": 1, "maxItems": 15, "items": { "$ref": "#/$defs/item" } }
      }
    }
  }
}
