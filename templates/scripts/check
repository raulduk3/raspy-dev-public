#!/usr/bin/env sh
# Repository check entry point. Keep this language-neutral; project-specific checks go in
# scripts/check-local and are run after the platform hygiene and version checks.
set -eu

root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
python3 "$root/scripts/checks/hygiene.py" --cwd "$root"
python3 "$root/scripts/version.py" --cwd "$root" >/dev/null
python3 "$root/scripts/checks/tasks.py" --cwd "$root"
if [ -x "$root/scripts/check-local" ]; then
  "$root/scripts/check-local"
fi
